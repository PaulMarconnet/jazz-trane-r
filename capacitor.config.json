{
  "appId": "com.pianoworkout.app",
  "appName": "Jazz Trane'R",
  "webDir": "www",
  "server": {
    "cleartext": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0a0c10",
